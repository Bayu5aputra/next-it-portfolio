# This file is a placeholder for environment variables required to run this project.

# OpenRouter API Key for the AI chatbot assistant
# Get your key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Google AI Studio Gemini API Key (Optional fallback if OpenRouter limit is reached)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Password for protected pages/routes
PAGE_ACCESS_PASSWORD=password

